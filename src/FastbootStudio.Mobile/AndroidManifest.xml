<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-feature android:name="android.hardware.usb.host" android:required="false" />
  <!-- Only for the update check: one request to the GitHub API, when the person allows it. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- While a flash, a kernel install, a backup or an OTG send runs, a foreground service with a notification keeps
       Android from killing the app half-way (Native/JobService.cs). The notification needs leave on Android 13+
       (asked once; the job runs either way), and the processor stays awake until the job ends. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <application android:allowBackup="false" android:icon="@mipmap/appicon" android:label="@string/app_name"
               android:supportsRtl="true" android:theme="@style/AppTheme">
    <service android:name="com.ifoknr.fastbootstudio.mobile.JobService" android:exported="false"
             android:foregroundServiceType="specialUse">
      <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Writing a boot partition or copying partitions to a backup, on this phone as root or on another phone over USB: it must not be cut off half-way." />
    </service>
    <!-- For the share sheet: serves only the files in the app's cache "export" folder, read-only, and only to the
         app a share was sent to (Native/ExportProvider.cs). Not exported. -->
    <provider android:name="com.ifoknr.fastbootstudio.mobile.ExportProvider"
              android:authorities="com.ifoknr.fastbootstudio.mobile.files"
              android:exported="false" android:grantUriPermissions="true" />
  </application>
</manifest>
