<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>FastbootStudio.Mobile</RootNamespace>
    <ApplicationId>com.ifoknr.fastbootstudio.mobile</ApplicationId>
    <ApplicationTitle>Fastboot Studio</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.0-beta.1</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- Phones; a test build for the x86_64 emulator passes -p:FbsRids=android-x64. -->
    <FbsRids Condition="'$(FbsRids)' == ''">android-arm64;android-arm</FbsRids>
    <RuntimeIdentifiers>$(FbsRids)</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FastbootStudio.Mobile.Core\FastbootStudio.Mobile.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The WebView UI; demo.js is only for previews in a desktop browser. -->
    <AndroidAsset Include="ui\**" Exclude="ui\demo.js" />
  </ItemGroup>
</Project>
